{
  "manifest_version": 3,
  "name": "Forms z Canvy",
  "version": "1.4",
  "description": "Počas prezentácie v Canve otvorí stránku forms.jurajkurek.com, keď sa zobrazí slajd s odkazom na ňu.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.canva.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
